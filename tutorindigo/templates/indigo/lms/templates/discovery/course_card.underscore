<a href="/courses/<%- course %>/about" class="learn-more" aria-label="" style="text-decoration: none;">
    <article class="course" role="region" aria-label="<%- content.display_name %>" style="border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1); background: white; display: flex; flex-direction: column; height: 332px; width: 100%; max-width: 330px; margin: 0 auto; overflow: hidden;">
        <header class="course-image" style="position: relative; padding: 0; flex-shrink: 0;">
            <div class="cover-image" style="border-radius: 12px 12px 0 0; overflow: hidden; height: 104px;">
                <!-- NEW IN INDIGO: Add fallback image in case of no course-image using onerror -->
                <img src="<%- image_url %>" 
                     onerror="this.src='/theming/asset/images/no_course_image.png';" 
                     alt="" 
                     style="width: 100%; height: 104px; object-fit: cover; object-position: top; margin: 0; display: block;" />
            </div>
            <div class="org-logo-container" style="position: absolute; top: 48px; left: 24px; z-index: 10;">
                <div style="display: inline-block; background: white; padding: 8px; border-radius: 4px; box-shadow: 0 2px 12px rgba(0,0,0,0.15); height: 66px; width: 116px; display: flex; align-items: center; justify-content: center;">
                    <% 
                        org_slug = org.lower().replace(' ', '-')
                    %>
                    <img src="/static/indigo/images/<%- org_slug %>.png"
                        alt="<%- org_slug %> Logo"
                        style="max-height: 50px; max-width: 100px; object-fit: scale-down; display: block;" 
                        />
                </div>
            </div>
        </header>
        <section class="course-info" style="padding: 24px 24px 0 24px; margin-top: 28px; flex-grow: 1; display: flex; flex-direction: column;">
            <h2 class="course-name" style="font-weight: bold; font-size: 16px; line-height: 1.25; margin: 0 0 4px 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; word-break: break-words;">
                <span class="course-title" style="display: block;"><%- content.display_name %></span>
            </h2>
            <div style="display: flex; flex-direction: column; width: 100%;">
                <span class="course-organization" style="font-size: 14px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%- org %></span>
            </div>
            
            <div style="flex-grow: 1;"></div>
            
            <div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-start; justify-content: flex-end; padding: 0 0 20px 0;">
                <div class="course-date" style="display: inline-flex; align-items: center; border-radius: 6px; border: 1px solid transparent; padding: 2px 10px; font-size: 12px; font-weight: 600; background-color: #f5f5f4; color: black; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 21" fill="none" aria-hidden="true" style="margin-right: 4px;">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M15 3.83332H15.8333C16.75 3.83332 17.5 4.58332 17.5 5.49999V17.1667C17.5 18.0833 16.75 18.8333 15.8333 18.8333H4.16667C3.24167 18.8333 2.5 18.0833 2.5 17.1667L2.50833 5.49999C2.50833 4.58332 3.24167 3.83332 4.16667 3.83332H5V2.16666H6.66667V3.83332H13.3333V2.16666H15V3.83332ZM4.16667 8.83332V17.1667H15.8333V8.83332H4.16667ZM15.8333 7.16666H4.16667V5.49999H15.8333V7.16666ZM14.1667 11.3333H10V15.5H14.1667V11.3333Z" fill="#9CA3AF"/>
                    </svg>
                    <%- interpolate(
                          gettext("Starts: %(start_date)s"),
                          { start_date: start }, true
                        ) %>
                </div>
            </div>
        </section>
        <div class="sr">
            <ul>
                <li><%- org %></li>
                <li><%- content.number %></li>
                <li><%- gettext("Starts") %><time itemprop="startDate" datetime="<%- start %>"><%- start %></time></li>
            </ul>
        </div>
    </article>
</a>